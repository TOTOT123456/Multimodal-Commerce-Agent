{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.agent.project/specs/agent_event.schema.json",
  "title": "Auditable Tool Planning Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conversation_id",
    "turn_id",
    "created_at",
    "raw_query",
    "resolved_query",
    "context_mode",
    "current_goals",
    "carried_goals",
    "cancelled_goals",
    "resolved_goals",
    "reference_turn_ids",
    "intent_type",
    "candidate_tools",
    "planned_tools",
    "strict_output",
    "status",
    "raw_planner_output",
    "prompt_version",
    "prompt_hash",
    "model_revision",
    "retrieval_revision",
    "route_hash",
    "agent_config_hash",
    "input_tokens",
    "output_tokens",
    "latency_ms",
    "warnings"
  ],
  "properties": {
    "conversation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "turn_id": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "raw_query": {"type": "string", "minLength": 1},
    "resolved_query": {"type": "string", "minLength": 1},
    "context_mode": {"enum": ["none", "recent", "long"]},
    "current_goals": {"type": "array", "items": {"$ref": "#/$defs/goal"}},
    "carried_goals": {"type": "array", "items": {"$ref": "#/$defs/goal"}},
    "cancelled_goals": {"type": "array", "items": {"$ref": "#/$defs/goal"}},
    "resolved_goals": {"type": "array", "items": {"$ref": "#/$defs/goal"}},
    "reference_turn_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "intent_type": {"enum": ["", "电商类", "闲聊类"]},
    "candidate_tools": {"$ref": "#/$defs/tool_ids"},
    "planned_tools": {"$ref": "#/$defs/tool_ids"},
    "strict_output": {"type": "boolean"},
    "status": {"enum": ["ok", "chitchat", "planner_invalid", "budget_rejected", "unresolved_reference", "backend_error"]},
    "raw_planner_output": {"type": "string"},
    "prompt_version": {"type": "string"},
    "prompt_hash": {"type": "string"},
    "model_revision": {"type": "string"},
    "retrieval_revision": {"type": "string"},
    "route_hash": {"type": "string"},
    "agent_config_hash": {"type": "string"},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "latency_ms": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0}
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "tool_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source_turn_ids", "origin", "order"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "source_turn_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "origin": {"enum": ["current", "carried", "retrieved"]},
        "order": {"type": "integer", "minimum": 0}
      }
    }
  }
}
